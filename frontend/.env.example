# Copy to .env.local (gitignored). Vite only exposes vars prefixed VITE_ to
# client code — see https://vite.dev/guide/env-and-mode
#
# This file only applies to `npm run dev`/`vite build` run directly. The
# Docker image (see ./Dockerfile) bakes VITE_API_BASE_URL in at build time
# via a --build-arg instead, since Vite reads import.meta.env values at
# build time, not from the container's environment at start -- see
# docker-compose.yml's `frontend.build.args` for the value used there.
VITE_API_BASE_URL=http://localhost:8000
