# Copy this file to .env and adjust as needed. .env is gitignored.

SERVER_NAME="IntelliDocs Tools"
HOST=0.0.0.0
PORT=8001
LOG_LEVEL=INFO

# The document_metadata tool calls the main backend's REST API. Running both
# services directly on the host, the default below is correct. Running the
# whole stack via `docker compose up -d --build` from the repo root instead,
# docker-compose.yml overrides this to the backend service's container name
# (http://backend:8000) automatically -- no manual change needed either way.
BACKEND_API_URL=http://localhost:8000
BACKEND_API_TIMEOUT_SECONDS=10

# Sent as the X-Internal-Api-Key header on that call (Phase 8) so the
# backend treats document_metadata as a trusted service rather than
# requiring a logged-in user's token, which this tool never has access to.
# Must match the backend's own INTERNAL_API_KEY exactly.
INTERNAL_API_KEY=

WEB_SEARCH_MAX_RESULTS=5
