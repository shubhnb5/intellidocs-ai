# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real secrets.

# --- App ---
APP_NAME="IntelliDocs AI"
ENVIRONMENT=development
DEBUG=true

# --- CORS ---
# Comma-separated list is fine too if you switch to a plain string field later;
# for now this is a JSON-style list parsed by pydantic-settings.
CORS_ALLOW_ORIGINS=["http://localhost:5173"]

# --- LLM (Anthropic Claude) ---
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# low | medium | high | xhigh | max — thinking/reasoning depth per request.
# "medium" trades a little quality for lower cost/latency; every agent node
# (router, tool selection, summarizer) shares this one setting for now.
CLAUDE_EFFORT=medium
CLAUDE_TIMEOUT_SECONDS=30
CLAUDE_MAX_RETRIES=2

# --- Vector DB (Qdrant) ---
# Run `docker compose up -d qdrant` from the repo root before starting the API,
# or run the whole stack via `docker compose up -d --build`.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=intellidocs_chunks

# --- Document ingestion ---
MAX_UPLOAD_SIZE_MB=20
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Embeddings (local, via fastembed — no API key needed) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# --- Relational DB (document metadata + entities/topics/summary) ---
# SQLite file, created automatically on startup. Swap for a Postgres URL in
# production (e.g. postgresql+psycopg2://user:pass@host/db).
DATABASE_URL=sqlite:///./intellidocs.db

# --- NLP pipeline ---
# Requires the spaCy model: python -m spacy download en_core_web_sm
NLP_MAX_CHARS=50000

# --- MCP server ---
# The Tool agent connects here. Run `python server.py` from mcp-server/ first,
# or run the whole stack via `docker compose up -d --build` from the repo root.
MCP_SERVER_URL=http://localhost:8001

# --- Redis (cache + rate limiting) ---
# Run `docker compose up -d redis` from the repo root before starting the API.
REDIS_URL=redis://localhost:6379/0
DOCUMENT_CACHE_TTL_SECONDS=30
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# --- Auth (JWT) ---
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Shared secret the MCP server presents to call GET /api/documents/{id} as a
# trusted service (its document_metadata tool) instead of a logged-in user.
# Must match mcp-server/.env's INTERNAL_API_KEY exactly. Generate the same
# way as JWT_SECRET_KEY. Leave both blank in local dev and that one MCP tool
# will 401 until you set them — everything else works without it.
INTERNAL_API_KEY=
