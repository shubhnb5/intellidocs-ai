# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real secrets.

# --- App ---
APP_NAME="IntelliDocs AI"
ENVIRONMENT=development
DEBUG=true

# --- CORS ---
# Comma-separated list is fine too if you switch to a plain string field later;
# for now this is a JSON-style list parsed by pydantic-settings.
CORS_ALLOW_ORIGINS=["http://localhost:5173"]

# --- LLM (Anthropic Claude) ---
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Vector DB (Qdrant) --- used from Phase 2 onward
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=intellidocs_chunks

# --- Redis (cache + rate limiting) --- used from Phase 8 onward
REDIS_URL=redis://localhost:6379/0

# --- Auth (JWT) --- used from Phase 8 onward
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
